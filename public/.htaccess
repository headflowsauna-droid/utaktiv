RewriteEngine On

# Tving HTTPS (kreves for GPS, service worker og "Legg til på Hjem-skjerm")
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Været: /api/met/<sti> -> api/met.php (legger på User-Agent som MET krever)
RewriteRule ^api/met/(.*)$ api/met.php?path=$1 [QSA,L]

# SPA Fallback: send andre ruter (f.eks. /auth/callback) til index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/api/
RewriteRule ^ index.html [L]

# Service worker må aldri caches hardt, ellers kommer ikke oppdateringer ut
<Files "sw.js">
  Header set Cache-Control "no-cache, max-age=0"
</Files>
<Files "index.html">
  Header set Cache-Control "no-cache, max-age=0"
</Files>

# Bygde filer har hash i navnet og kan caches lenge
<FilesMatch "^index-.*\.(js|css)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

AddType application/manifest+json .webmanifest
AddType application/vnd.android.package-archive .apk
